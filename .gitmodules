[submodule "ggml"]
    path = ggml
	# ⚠️ dbrain/ggml, NOT leejet/ggml. This fork's ggml pin (2eb82c09 and later) exists ONLY in
	# our fork — upstream leejet/ggml does not contain it, so `git clone --recurse-submodules`
	# of this repo against the old URL could not fetch its own submodule and every remote build
	# had to fall back to local source. HTTPS (not SSH) because the Docker builders clone with
	# no SSH agent; dbrain/ggml is public, verified with an anonymous `git ls-remote`.
	url = https://github.com/dbrain/ggml.git
[submodule "examples/server/frontend"]
	path = examples/server/frontend
	url = https://github.com/leejet/sdcpp-webui.git
[submodule "thirdparty/libwebp"]
	path = thirdparty/libwebp
	url = https://github.com/webmproject/libwebp.git
[submodule "thirdparty/libwebm"]
	path = thirdparty/libwebm
	url = https://github.com/webmproject/libwebm.git
[submodule "thirdparty/eigen_reference"]
	path = thirdparty/eigen_reference
	url = https://gitlab.com/libeigen/eigen.git
[submodule "thirdparty/flash_attention"]
	# Source for GGML_PIXAL_FA2 (tools/m1_ref image-to-rig rig decoder). ggml's CUDA
	# CMakeLists applies tools/m1_ref/cpp_port/flash_attention_native.patch to this
	# checkout at configure time, so it is expected to read dirty once configured.
	# Needs its own csrc/cutlass submodule (`--recursive`).
	# `ignore = dirty` because that configure-time patch dirties the checkout on EVERY build:
	# without it `git status` in this repo permanently reports a modified submodule, which trains
	# the reader to ignore the one line that would matter if the PIN ever moved. The pin itself is
	# still tracked and still shows up when it changes.
	ignore = dirty
	path = thirdparty/flash_attention
	url = https://github.com/Dao-AILab/flash-attention.git
